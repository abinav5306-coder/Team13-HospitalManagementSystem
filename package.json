{
  "name": "team13-hospital-management-system",
  "version": "1.0.0",
  "description": "Team13 Hospital Management System with modern React Admin and Patient Portals",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "npm run dev --prefix frontend",
    "build:client": "npm run build --prefix frontend"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "nodemailer": "^10.0.16",
    "twilio": "^6.1.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
